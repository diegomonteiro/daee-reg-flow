<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Sistema de regionalização de vazões do Estado de São Paulo">
  <meta name="theme-color" content="#063f4c">
  <title>REG-FLOW — Regionalização de vazões</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><path fill=%22%23086fc1%22 d=%22M12 2C8.8 6.4 5 10.4 5 15a7 7 0 0014 0c0-4.6-3.8-8.6-7-13Z%22/></svg>">
  <link rel="preconnect" href="https://tile.openstreetmap.org">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
  <link rel="stylesheet" href="https://unpkg.com/@geoman-io/leaflet-geoman-free@2.20.0/dist/leaflet-geoman.css">
  <link rel="stylesheet" href="<%= basePath %>/stylesheets/style.css?v=20261024a">
</head>
<body>
  <header class="app-header">
    <a class="brand" href="<%= basePath || '/' %>" aria-label="SP-ÁGUAS — REG-FLOW, página inicial">
      <img class="institution-logo" src="<%= basePath %>/images/SP-%C3%81guas-Branco.png" alt="" width="2016" height="1341">
      <span class="brand-divider" aria-hidden="true"></span><span class="brand-name">REG-FLOW</span><span class="brand-divider brand-divider-secondary" aria-hidden="true"></span>
      <span class="brand-subtitle">Regionalização de vazões</span>
    </a>
    <div class="header-actions">
      <button class="header-action" id="toggle-panels-visibility" type="button" aria-pressed="false" title="Ocultar painéis para visualizar o mapa"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg><span id="toggle-panels-label">Ocultar painéis</span></button>
      <button class="header-action" id="open-regularization-header" type="button" aria-controls="regularization-dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2"/><path d="M3 13c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2"/><path d="M5 19h14"/></svg><span>Regularização de vazão</span></button>
      <button class="header-action" id="open-search" type="button" aria-controls="search-panel"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>Nova consulta</span></button>
    </div>
  </header>

  <main class="workspace">
    <div id="map" aria-label="Mapa interativo do Estado de São Paulo"></div>
    <button class="search-restore-button" id="restore-search-panel" type="button" aria-controls="search-panel" aria-expanded="false" title="Mostrar painel Consultar vazão" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <span>Consultar vazão</span>
      <svg class="restore-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <section class="search-panel open" id="search-panel" aria-labelledby="search-title">
      <div class="panel-heading"><div><h1 id="search-title">Consultar vazão</h1><p>Informe um ponto em São Paulo ou selecione-o no mapa.</p></div>
        <button class="icon-button search-close" id="close-search" type="button" aria-label="Ocultar painel de consulta" title="Ocultar painel de consulta"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg></button>
      </div>
      <form id="coordinate-form" novalidate>
        <div class="coordinate-fields">
          <label class="field"><span>Latitude</span><input type="number" id="latitude" min="-90" max="90" step="any" inputmode="decimal" placeholder="-23,550000" required></label>
          <label class="field"><span>Longitude</span><input type="number" id="longitude" min="-180" max="180" step="any" inputmode="decimal" placeholder="-46,633309" required></label>
        </div>
        <p class="field-help">Use graus decimais. Exemplo: −23,550000; −46,633309.</p>
        <label class="upstream-option" for="partial-basin">
          <input type="checkbox" id="partial-basin" checked>
          <span class="upstream-check" aria-hidden="true"></span>
          <span>Cálculo parcial da bacia (somente área à montante do ponto; desmarque para ottobacia inteira)</span>
        </label>
        <label class="upstream-option" for="include-upstream">
          <input type="checkbox" id="include-upstream">
          <span class="upstream-check" aria-hidden="true"></span>
          <span>Considerar bacias à montante até a nascente (ottocodificação)</span>
        </label>
        <div class="form-actions">
          <button class="button button-secondary" id="start-drawing" type="button" title="Desenhar uma bacia hidrográfica">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 17 5-11 10 4-2 9H7Z"/><circle cx="9" cy="6" r="1.5"/><circle cx="19" cy="10" r="1.5"/><circle cx="17" cy="19" r="1.5"/><circle cx="4" cy="17" r="1.5"/></svg>
            <span>Desenhar bacia</span>
          </button>
          <button class="button button-secondary button-cancel-draw" id="cancel-drawing" type="button" title="Cancelar desenho da bacia" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            <span>Cancelar desenho</span>
          </button>
          <button class="button button-secondary" id="locate-button" type="button"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8"/><path d="M12 2V5M12 19v3M2 12h3M19 12h3"/></svg><span>Minha localização</span></button>
          <button class="button button-primary" id="calculate-button" type="submit"><svg class="button-icon" viewBox="0 0 24 24"><path d="M12 3C9 7.2 6 10.6 6 14.5a6 6 0 0 0 12 0C18 10.6 15 7.2 12 3Z"/></svg><span>Calcular vazão</span><span class="spinner" aria-hidden="true"></span></button>
        </div>
        <p class="drawing-status" id="drawing-instructions" role="status" hidden>Adicione os vértices no mapa e clique no primeiro ponto para finalizar. <kbd>D</kbd> desfaz o último ponto.</p>
      </form>
    </section>

    <div class="draw-toolbar" id="draw-toolbar" aria-label="Ferramentas de desenho" hidden>
      <button class="draw-button" id="cancel-drawing-mobile" type="button" aria-label="Cancelar desenho" title="Cancelar desenho">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        <span>Cancelar desenho</span>
      </button>
    </div>

    <aside class="isohyet-editor" id="isohyet-editor" hidden aria-labelledby="isohyet-editor-title">
      <div class="editor-heading"><div><p>Editor de cenário</p><h2 id="isohyet-editor-title">Editar isoietas históricas</h2></div><button class="icon-button" id="cancel-isohyet-edit" type="button" aria-label="Cancelar edição"><svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
      <p class="editor-help">Selecione uma faixa colorida no mapa para alterar seu valor ou seus vértices.</p>
      <label class="editor-field">Precipitação da faixa selecionada <span><input id="isohyet-value" type="number" min="1" max="10000" step="1" disabled><b>mm</b></span></label>
      <div class="editor-actions"><button class="button button-secondary" id="apply-isohyet-value" type="button" disabled>Aplicar valor</button><button class="button button-secondary" id="toggle-isohyet-shape" type="button" disabled>Editar forma</button></div>
      <div class="regional-adjustment"><h3>Variação por região</h3><p>Defina o percentual e desenhe a área que receberá a alteração.</p><label>Variação <span><input id="isohyet-percentage" type="number" min="-99" max="500" step="1" value="10"><b>%</b></span></label><button class="button button-secondary" id="draw-adjustment-region" type="button">Desenhar região</button></div>
      <p class="editor-status" id="isohyet-editor-status" role="status" aria-live="polite">Nenhuma faixa selecionada.</p>
      <button class="button button-primary editor-save" id="save-isohyet-edit" type="button">Salvar como novo cenário</button>
    </aside>

    <button class="results-edge-toggle" id="toggle-results-sidebar" type="button" aria-controls="results-panel" aria-expanded="false" aria-label="Expandir painel de resultados" title="Expandir painel de resultados">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <aside class="results-panel" id="results-panel" aria-labelledby="results-title" aria-hidden="true">
      <div class="results-header"><div><p>Consulta regionalizada</p><h2 id="results-title">Resultados</h2></div><button class="icon-button" id="close-results" type="button" aria-label="Fechar resultados"><svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
      <div class="results-empty" id="results-empty"><div class="empty-icon"><svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></div><h3>Selecione um ponto</h3><p>Preencha as coordenadas ou clique no mapa para calcular as vazões da bacia correspondente.</p></div>
      <div class="results-loading" id="results-loading" hidden aria-live="polite"><div class="loading-mark"></div><h3>Analisando a bacia</h3><p>Cruzando limites, precipitação e regiões hidrológicas.</p><div class="skeleton-list"><i></i><i></i><i></i><i></i></div></div>
      <div class="results-content" id="results-content" hidden>
        <dl class="parameter-list"><div><dt>Bacia</dt><dd id="result-basin">—</dd></div><div><dt>Área da bacia</dt><dd id="result-area">—</dd></div><div><dt>Curso d’água</dt><dd id="result-watercourse">—</dd></div><div><dt>Extensão do trecho</dt><dd id="result-stream-length">—</dd></div><div><dt>Ponto montante</dt><dd id="result-upstream">—</dd></div><div><dt>Ponto jusante</dt><dd id="result-downstream">—</dd></div><div><dt>Região A/U</dt><dd id="result-rau">—</dd></div><div><dt>Região XYZ</dt><dd id="result-rxyz">—</dd></div></dl>
        <section class="basin-overlaps" id="upstream-basins-section" hidden aria-labelledby="upstream-basins-title"><div><h3 id="upstream-basins-title">Ottobacias à montante</h3><span id="upstream-basins-count"></span></div><p id="upstream-basins-description">Agregação hidrográfica pela ottocodificação (montante/jusante) até a nascente.</p><ol id="upstream-basins-list"></ol></section>
        <section class="basin-overlaps" id="basin-overlaps" hidden aria-labelledby="basin-overlaps-title"><div><h3 id="basin-overlaps-title">Ottobacias na área desenhada</h3><span id="basin-overlaps-count"></span></div><p>Participação de cada ottobacia na área desenhada e percentual da própria ottobacia coberto pelo desenho.</p><ol id="basin-overlaps-list"></ol></section>
        <details class="coefficients"><summary>Ver coeficientes do cálculo</summary><dl class="parameter-list compact"><div><dt>A Média</dt><dd id="result-avg-a">—</dd></div><div><dt>B Média</dt><dd id="result-avg-b">—</dd></div><div><dt>Coeficiente a</dt><dd id="result-coef-a">—</dd></div><div><dt>Coeficiente b</dt><dd id="result-coef-b">—</dd></div><div><dt>Coeficiente c</dt><dd id="result-coef-c">—</dd></div></dl></details>
        <div class="metric-list">
          <article class="metric"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M7 17a4 4 0 0 1-.5-8A6 6 0 0 1 18 10a3.5 3.5 0 0 1-.5 7H7Z"/><path d="m9 19-1 2M13 19l-1 2M17 19l-1 2"/></svg></div><div><span>Precipitação anual média</span><strong id="result-rain">—</strong></div></article>
          <article class="metric"><div class="metric-icon"><svg viewBox="0 0 24 24"><path d="M3 8c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2M3 13c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2M3 18c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2"/></svg></div><div><span>Vazão média plurianual</span><strong id="result-average">—</strong></div></article>
          <article class="metric emphasis"><div class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2"/><path d="m7 16 3 3 7-7"/></svg></div><div><span>Vazão Q95%</span><strong id="result-q95">—</strong></div></article>
          <article class="metric emphasis"><div class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16M8 14h.01M12 14h.01M16 14h.01"/></svg></div><div><span>Vazão Q<sub>7,10</sub></span><strong id="result-q710">—</strong></div></article>
        </div>
        <p class="method-note">Estimativas produzidas pelo método de regionalização. Confirme premissas e limitações antes do uso técnico.</p>
        <button class="simulation-trigger regularization-trigger" id="open-regularization" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2"/><path d="M3 13c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2"/><path d="M5 19h14"/></svg><span>Simular regularização de vazão</span></button>
        <button class="simulation-trigger" id="open-simulation" type="button" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-8M22 19H2"/><path d="m3 6 5-3 6 4 7-5"/></svg><span>Simular outras isoietas</span></button>
      </div>
    </aside>
    <div class="map-hint" id="map-hint" role="status">Clique no mapa para escolher um ponto</div>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden><span class="toast-icon"></span><span id="toast-message"></span><button type="button" id="close-toast" aria-label="Fechar aviso">×</button></div>
  </main>

  <dialog class="simulation-dialog" id="simulation-dialog" aria-labelledby="simulation-title">
    <div class="simulation-header"><div><p>Comparação de cenários</p><h2 id="simulation-title">Simulação com outras isoietas</h2></div><button class="icon-button" id="close-simulation" type="button" aria-label="Fechar simulação"><svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="simulation-body">
      <p class="simulation-intro">Compare a camada histórica com até cinco arquivos GeoJSON. Cada feição deve ser um polígono com a precipitação anual em <code>ID</code>, <code>rain</code>, <code>precipitation</code>, <code>precipitacao</code>, <code>P</code> ou <code>mm</code>.</p>
      <section class="scenario-picker" aria-labelledby="scenario-title">
        <div class="section-heading"><div><h3 id="scenario-title">Isoietas da simulação</h3><p>Selecione uma ou mais camadas.</p></div><label class="upload-button" for="isohyet-upload"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 15v5h16v-5"/></svg>Adicionar GeoJSON</label><input id="isohyet-upload" type="file" accept=".geojson,.json,application/geo+json,application/json" multiple hidden></div>
        <div class="scenario-list" id="scenario-list"></div>
        <p class="upload-help" id="upload-help">Os arquivos ficam somente nesta sessão e não são armazenados no servidor.</p>
      </section>
      <div class="simulation-actions"><p id="simulation-status" role="status" aria-live="polite"></p><button class="button button-primary" id="run-simulation" type="button"><span>Executar simulação</span><span class="spinner" aria-hidden="true"></span></button></div>
      <section class="comparison-results" id="comparison-results" hidden aria-labelledby="comparison-title">
        <div class="comparison-heading"><div><p>Resultado comparativo</p><h3 id="comparison-title">Efeito das isoietas nas vazões</h3></div><span id="comparison-count"></span></div>
        <p class="comparison-summary" id="comparison-summary"></p>
        <div class="comparison-chart" id="comparison-chart" role="img"></div>
        <div class="comparison-table-wrap"><table class="comparison-table"><caption>Valores calculados por cenário de isoietas</caption><thead><tr><th scope="col">Cenário</th><th scope="col">Precipitação</th><th scope="col">Vazão média</th><th scope="col">Q95%</th><th scope="col">Q<sub>7,10</sub></th></tr></thead><tbody id="comparison-table-body"></tbody></table></div>
        <p class="comparison-note">As diferenças decorrem somente da troca da camada de precipitação. A geometria da bacia e os coeficientes regionais permanecem constantes.</p>
      </section>
    </div>
  </dialog>

  <dialog class="simulation-dialog regularization-dialog" id="regularization-dialog" aria-labelledby="regularization-title">
    <div class="simulation-header">
      <div>
        <p>Volume de armazenamento intra-anual · Equações (12) a (15) — DAEE</p>
        <h2 id="regularization-title">Regularização de vazão e simulação de cenários</h2>
      </div>
      <button class="icon-button" id="close-regularization" type="button" aria-label="Fechar regularização de vazão"><svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="simulation-body">
      <div class="reg-formula-banner">
        <p class="simulation-intro" style="margin:0 0 10px">Calcula o volume de armazenamento intra-anual (<b>V<sub>c</sub></b>) necessário para regularizar uma demanda firme <b>Q<sub>F</sub></b> (m³/s), associado a uma probabilidade <b>y% = (100/T)%</b> de não atendimento em um ano qualquer (período de retorno <b>T</b> em anos), aplicando as <b>Equações (14) e (15)</b> da metodologia oficial do DAEE (1988) para durações críticas de até 6 meses.</p>
        <div class="reg-equations-grid">
          <div class="reg-equation-box">
            <span class="reg-eq-tag">Equação (14) — Volume máximo de regularização</span>
            <code>V<sub>c</sub> = [ [ Q<sub>F</sub> − (X<sub>T</sub> · A · Q̄) ]² / (4 · X<sub>T</sub> · B · Q̄) ] · K</code>
            <small>K = 2.628.000 s/mês · Resultado em m³ e hm³ (10⁶ m³)</small>
          </div>
          <div class="reg-equation-box">
            <span class="reg-eq-tag">Equação (15) — Duração crítica da estiagem</span>
            <code>d<sub>c</sub> = [ Q<sub>F</sub> − (X<sub>T</sub> · A · Q̄) ] / (2 · X<sub>T</sub> · B · Q̄)</code>
            <small>Válida para regularização intra-anual com 0 &lt; d<sub>c</sub> ≤ 6 meses</small>
          </div>
        </div>
      </div>

      <section class="scenario-picker reg-section" aria-labelledby="reg-base-title">
        <div class="section-heading">
          <div>
            <h3 id="reg-base-title">1. Parâmetros regionais e disponibilidade hídrica (Q̄)</h3>
            <p>Utilize os parâmetros da bacia calculada no mapa ou selecione uma das 21 regiões hidrográficas homogêneas (A a U).</p>
          </div>
          <div class="reg-preset-actions">
            <button class="upload-button" id="reg-use-map-basin" type="button" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>Usar bacia do mapa</button>
            <button class="upload-button" id="reg-load-daee-example" type="button" title="Exemplo do artigo DAEE (1988): Rio Buquira — Região H, Área 401,5 km², P = 1.685 mm/ano, Q̄ = 9,48 m³/s, QF = 5,0 m³/s, T = 10 anos (10%)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>Carregar exemplo DAEE (Região H)</button>
          </div>
        </div>

        <div class="reg-form-grid">
          <label class="field">
            <span>Origem dos parâmetros</span>
            <select id="reg-source-mode" class="reg-select">
              <option value="map" id="reg-source-map-option">Bacia selecionada no mapa</option>
              <option value="region" selected>Região hidrográfica DAEE (A–U)</option>
            </select>
          </label>
          <label class="field" id="reg-region-field">
            <span>Região hidrográfica (Figura 5 — DAEE)</span>
            <select id="reg-region-select" class="reg-select"></select>
          </label>
          <label class="field">
            <span>Modo de obtenção de Q̄</span>
            <select id="reg-q-mode" class="reg-select">
              <option value="calculated" id="reg-q-calculated-option">Usar vazão calculada da bacia (Q̄)</option>
              <option value="direct" selected>Informar vazão média Q̄ (m³/s) diretamente</option>
              <option value="rainfall">Calcular Q̄ por Área (km²) e Precipitação P̄ (mm/ano) — Eq. (1)</option>
            </select>
          </label>
          <label class="field" id="reg-q-direct-field">
            <span id="reg-q-direct-label">Vazão média plurianual Q̄ (m³/s)</span>
            <input type="number" id="reg-avg-q" min="0.001" step="any" value="9.48">
          </label>
          <label class="field" id="reg-area-field" hidden>
            <span>Área de drenagem (km²)</span>
            <input type="number" id="reg-area-km2" min="0.01" step="any" value="401.5">
          </label>
          <label class="field" id="reg-rain-field" hidden>
            <span>Precipitação anual média P̄ (mm/ano)</span>
            <input type="number" id="reg-rainfall-mm" min="100" max="10000" step="any" value="1685">
          </label>
        </div>

        <div class="reg-params-summary" id="reg-params-summary" aria-live="polite"></div>
      </section>

      <section class="scenario-picker reg-section" aria-labelledby="reg-scenarios-title">
        <div class="section-heading">
          <div>
            <h3 id="reg-scenarios-title">2. Cenários de demanda (Q<sub>F</sub>) e probabilidade de não atendimento (y% / T)</h3>
            <p>Adicione até 12 cenários variando a vazão firme regularizada (x m³/s) e o risco anual de não atendimento (y% = 100/T).</p>
          </div>
          <div class="reg-preset-actions">
            <button class="upload-button" id="reg-add-all-risks" type="button" title="Gera automaticamente 6 cenários para a vazão QF informada com T = 10, 15, 20, 25, 50 e 100 anos">Gerar curva de riscos (T = 10 a 100 anos)</button>
            <button class="upload-button" id="reg-clear-scenarios" type="button">Limpar lista</button>
          </div>
        </div>

        <div class="reg-builder-grid">
          <label class="field">
            <span>Vazão a regularizar Q<sub>F</sub> (m³/s)</span>

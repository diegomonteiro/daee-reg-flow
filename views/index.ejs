    function setLoading(value) { calculateButton.disabled = value; locateButton.disabled = value; startDrawingButton.disabled = value; calculateButton.classList.toggle('loading', value); empty.hidden = true; content.hidden = true; loading.hidden = !value; if (value) openResults(); }
    function selectPoint(lat, lon, center = false) { latInput.value = Number(lat).toFixed(6); lonInput.value = Number(lon).toFixed(6); marker ? marker.setLatLng([lat, lon]) : marker = L.marker([lat, lon], { alt: 'Ponto selecionado' }).addTo(map); if (center) map.setView([lat, lon], Math.max(map.getZoom(), 11)); text('map-hint', 'Ponto selecionado — clique em Calcular vazão'); byId('map-hint').classList.add('selected'); }
    function polygonArea(feature) { const ringArea = ring => Math.abs(ring.reduce((sum, p, i) => { const q = ring[(i + 1) % ring.length]; return sum + (q[0] - p[0]) * Math.PI / 180 * (2 + Math.sin(p[1] * Math.PI / 180) + Math.sin(q[1] * Math.PI / 180)); }, 0) * 6378137 * 6378137 / 2); const g = feature.geometry, polygons = g.type === 'Polygon' ? [g.coordinates] : g.coordinates; return polygons.reduce((sum, p) => sum + ringArea(p[0]) - p.slice(1).reduce((s, r) => s + ringArea(r), 0), 0) / 1e6; }
    function streamPointMarker(point, type, fallbackLabel) {

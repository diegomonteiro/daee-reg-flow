<script>
  var map = L.map('map').setView([-22.255, -48.14], 7);

  var hash = new L.Hash(map);

  var overlayMaps = {};

  var scalebar = L.control.scale({ metric: true, imperial: false, maxWidth: 200 }).addTo(map);
  
  var isolineGroup = L.layerGroup();
  var basinGroup   = L.layerGroup();

  //mapbox://styles/diegomonteiro/ckzsznqn1001b14k5jqpw442k
  //mapbox://styles/diegomonteiro/ckzszx8bu001514qupk8mtfdr
  //mapbox://styles/diegomonteiro/clkwkcjsi00db01pb7ws27c3o
  var baseMaps = new L.basemapsSwitcher([
    {
      layer: L.tileLayer('https://api.mapbox.com/styles/v1/diegomonteiro/ckzt04tmb000x15pnabkxg5fc/tiles/256/{z}/{x}/{y}@2x?access_token=pk.eyJ1IjoiZGllZ29tb250ZWlybyIsImEiOiJjaWtpeTNucGYwNTdudTBtNjMzeW80Y2FsIn0.D1Y1o7NvJA6hwrKAs_NcIg', {
        maxZoom: 22,
        attribution: '&copy; <a href="http://www.mapbox.com">Mapbox</a>'
      }).addTo(map),
      icon: 'images/mapbox-daee.png',
      name: 'Mapbox'
    },
    {
      layer: L.tileLayer('https://api.mapbox.com/styles/v1/diegomonteiro/ckzsznqn1001b14k5jqpw442k/tiles/256/{z}/{x}/{y}@2x?access_token=pk.eyJ1IjoiZGllZ29tb250ZWlybyIsImEiOiJjaWtpeTNucGYwNTdudTBtNjMzeW80Y2FsIn0.D1Y1o7NvJA6hwrKAs_NcIg', {
        maxZoom: 22,
        attribution: '&copy; <a href="http://www.mapbox.com">Mapbox</a>'
      }),
      icon: 'images/mapbox-outdoors.png',
      name: 'Outdoors'
    },
    {
      layer: L.tileLayer('https://api.mapbox.com/styles/v1/diegomonteiro/ckzszx8bu001514qupk8mtfdr/tiles/256/{z}/{x}/{y}@2x?access_token=pk.eyJ1IjoiZGllZ29tb250ZWlybyIsImEiOiJjaWtpeTNucGYwNTdudTBtNjMzeW80Y2FsIn0.D1Y1o7NvJA6hwrKAs_NcIg', {
        maxZoom: 22,
        attribution: '&copy; <a href="http://www.mapbox.com">Mapbox</a>'
      }),
      icon: 'images/mapbox-satelite.png',
      name: 'Satélite'
    },
    {
      layer: L.tileLayer.wms('https://datageo.ambiente.sp.gov.br/geoimage/datageoimg/ows?SERVICE=WMS',{
        layers: 'ESP_IMG_RAPIDEYE_2013_2014',
        format: 'image/png',
        transparent: true,
        attribution: 'RapidEYE 2013/2014'
      }),
      icon: 'images/mapbox-satelite.png',
      name: 'Rapideye'
    },
    {
      layer: L.tileLayer.wms('https://datageo.ambiente.sp.gov.br/geoimage/datageoimg/ORTOFOTOS_EMPLASA_2010/ows?SERVICE=WMS',{
        layers: 'ORTOFOTOS_EMPLASA_2010',
        format: 'image/png',
        transparent: true,
        attribution: 'Emplasa 2010/2011'
      }),
      icon: 'images/mapbox-satelite.png',
      name: 'Emplasa'
    }
    ,
  ], { position: 'bottomright' }).addTo(map);

  var controlLayer = L.control.layers({}, overlayMaps).addTo(map);
  
  controlLayer.addOverlay(isolineGroup, "Isolinhas");
  controlLayer.addOverlay(basinGroup, "Ottobacias");
  
  var heights = [];


  var aux_markers = L.markerClusterGroup({
    animate:false,
    removeOutsideVisibleBounds:true,
    spiderfyOnMaxZoom: true,
    showCoverageOnHover: true,
    zoomToBoundsOnClick: true,
    maxClusterRadius: 30
  });

  //map.addLayer(aux_markers);
  
  //Add Draw Controls
  map.pm.addControls({  
    position: 'topleft',  
    drawCircle: false,
    drawCircleMarker: false,
    drawRectangle: false,
    drawPolyline: false
  });

  const modal_filtro = new bootstrap.Modal('#modal-filtro');
  const modal_calc_q710 = new bootstrap.Modal("#modal-calculate-q710");

  if(window.location.hash==''){
    //modal_filtro.show();
    modal_calc_q710.show();
  }
  else if(window.location.hash.split("/").length == 3){
    var coords = window.location.hash.split("/")
    var latitude  = parseFloat(coords[1]);
    var longitude = parseFloat(coords[2]);
    var zoom      = coords[0].replace("#","");

    console.log("lat: ", latitude)
    console.log("lon: ", longitude)
    console.log("zoom: ", zoom);

    $("#latitude").val(latitude);
    $("#longitude").val(longitude);
  }

  $("#btn_calc").on('click', function(e){
    modal_calc_q710.show();
  })

  map.on('moveend', function(e){
    console.log("Map moveend: ", e);

    var coords = window.location.hash.split("/")
    var latitude  = parseFloat(coords[1]);
    var longitude = parseFloat(coords[2]);
    var zoom      = coords[0].replace("#","");

    console.log("lat: ", latitude)
    console.log("lon: ", longitude)
    console.log("zoom: ", zoom);

    $("#latitude").val(latitude);
    $("#longitude").val(longitude);
  })

  //Monitoring Layers Add/Delete
  map.on('layeradd', function(e){
    //console.log("Layer Added: ", e);
  });

  map.on('pm:drawstart', function(e){
    console.log("Start Draw");
  })
  
  map.on('pm:create', (e) => {
    L.PM.reInitLayer(e.layer);

    var drawed_layers = L.PM.Utils.findLayers(map);
    //Checking layers includes
    var shape_types = _.uniq(_.map(drawed_layers, function(o){ return o.pm._shape; }));

    console.log("Shapes drawed: ", shape_types);

    //if(_.includes(shape_types, "Marker") && _.includes(shape_types, "Polygon")){
    if(_.includes(shape_types, "Polygon")){
      //var points = _.filter(drawed_layers, function(o){ return o.pm._shape == "Marker" });
      var basins = _.filter(drawed_layers, function(o){ return o.pm._shape == "Polygon" });    

      //Get first or last coordinates points to set a start point of basin
      var points = [L.marker(_.first(basins)._latlngs[0][0])]

      console.log("Points basin: ", points);

      var turf_points = [];

      console.log("Points Drawed: ", points)
      console.log("Basins Drawed: ", basins)

      var latitude;
      var longitude;

      //Fill with points to make a Grid
      $.each(points, function(k,point){
        console.log("Render Point Drawed => ", point);

        latitude = point._latlng.lat;
        longitude = point._latlng.lng;

        $("#txt-coords").html(latitude+", "+longitude);
        //latitude = e.layer._latlng.lat;
        //longitude = e.layer._latlng.lng;
        turf_points.push(turf.point([longitude, latitude]));

      })

      $.each(basins, function(k,basin){

        //Add event click
        basin.on('click', function(e){
          //alert("Click on basin");
          //Configure to reopen offcanvas with results
          console.log("Click on basin");
          const bsOffcanvas = new bootstrap.Offcanvas('#results_tab')
          bsOffcanvas.show()
        })

        var points_grid = turf.featureCollection(turf_points);
        console.log("Points Grid: ", points_grid);

        //var pts = turf.pointsWithinPolygon(points_grid, basin.toGeoJSON());
        var pts = points_grid;
        console.log("Points Pts: ", pts);

        var basin_area = turf.area(basin.toGeoJSON())/1000000;
        var basin_border = turf.polygonToLine(basin.toGeoJSON());
        var perimeter = turf.length(basin_border, {units: 'kilometers'});

        turf.featureEach(pts, function (currentPoint, featureIndex) {
          var avg_rainfall = getAvgAnnualRainByRegion(basin);
          var region_coefs = getAvgCoefsByRegion(basin_border);

          console.log("Avg.Rainfall: ", avg_rainfall)
          console.log("Coefs By Region: ", region_coefs);

          
          $("#txt-area-drawed").html(basin_area.toFixed(2))
          //$("#txt-avg-discharge").html(qms.avg.toFixed(2))
          $("#txt-avg-rainfall").html(avg_rainfall.toFixed(2))

          $.get(`/api/calculate_discharge_avg/${region_coefs.rau.a}/${region_coefs.rau.b}/${avg_rainfall}/${basin_area}`, function(qms){
            console.log("Qms: ", qms);
            $("#txt-avg-discharge").html(qms.avg.toFixed(2))

            var requests_q95s = [];
            var requests_q7s  = [];
            //Get by Areas
            _.each(region_coefs.rau.bands, function(region_rau, region_rau_key){
              //console.log(region_rau_key," => ",region_rau);
              requests_q95s.push($.get(`/api/calculate_q95/${region_rau.properties.region}/${qms.avg}/${region_rau.properties.partial_area}`));

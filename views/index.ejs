  /**
   * Method to calculate Coeficients by Area
   * */
  function getAvgCoefsByRegion(basin_border_geo){
    var coefbands_bounds = turf.bbox(basin_border_geo);
    var extent = coefbands_bounds;
    var cellSide = 1;

    var options = {units: 'kilometers'};

    var avg_coefs_areas_rau;
    var avg_coefs_areas_rxyz;

    var avg_coefs_points_rau;
    var avg_coefs_points_rxyz;

    var point_grids = turf.pointGrid(extent, cellSide, options);

    //Areas
    var coef_avg_weighted_areas_rau = [];
    var coef_avg_weighted_areas_rxyz = [];

    //Rau AVG Weighted
    rau_avg_a_weighted_areas = [];
    rau_avg_b_weighted_areas = [];
    rau_avg_xt10_weigted_areas = [];
    rau_avg_coef_a_weighted_areas = [];
    rau_avg_coef_b_weighted_areas = [];
    rau_avg_qp95_weighted_areas = [];
    rain_avg_weighted_areas = [];
    rain_avg_weighted_points = [];

    //Rxyz AVG Weighted
    var rxyz_avg_weighted_areas = [];

    //Bands
    var rau_bands = [];
    var rxyz_bands = [];

    //Each by Coef A..U
    turf.featureEach(rau_geo, function(rau_feature, rau_index){
      //Getting points inside polygon
      var pts = turf.pointsWithinPolygon(point_grids, rau_feature);

      if(pts.features.length > 0){        
        //Each by basins features
        turf.featureEach(basin_border_geo, function(basinFeature, basinIndex){
          var rau_band = turf.intersect(turf.lineToPolygon(basinFeature), rau_feature);
          if(rau_band){
            var partial_area = turf.area(rau_band.geometry)/1000000;
            var avg_rau_obj = {
              id: rau_feature.properties.ID,
              region: rau_feature.properties.REGIAO,
              avg_a: rau_feature.properties.A_MEDIA,
              avg_b: rau_feature.properties.B_MEDIA,
              xt_10: rau_feature.properties.XT10,
              coef_a: rau_feature.properties.A,
              coef_b: rau_feature.properties.B,
              qp95: rau_feature.properties.QP95,
              partial_area: partial_area
            };
            
            rau_band.properties = _.merge(avg_rau_obj, basinFeature.properties);
              
            //Weight areas coefs
            rau_avg_a_weighted_areas.push({value: avg_rau_obj.avg_a, weight: partial_area});
            rau_avg_b_weighted_areas.push({value: avg_rau_obj.avg_b, weight: partial_area});
            rau_avg_xt10_weigted_areas.push({value: avg_rau_obj.xt_10, weight: partial_area});
            rau_avg_coef_a_weighted_areas.push({value: avg_rau_obj.coef_a, weight: partial_area});
            rau_avg_coef_b_weighted_areas.push({value: avg_rau_obj.coef_b, weight: partial_area});
            rau_avg_qp95_weighted_areas.push({value: avg_rau_obj.qp95, weight: partial_area});

            rau_bands.push(rau_band);                      
          }
        });
      }
    });

    //Each by Coef XYZ
    turf.featureEach(rxyz_geo, function(rxyz_feature, rxyz_index){
      //Getting points inside polygon
      var pts = turf.pointsWithinPolygon(point_grids, rxyz_feature);

      if(pts.features.length > 0){
        //Each by basins features
        turf.featureEach(basin_border_geo, function(basinFeature, basinIndex){
          var rxyz_band = turf.intersect(turf.lineToPolygon(basinFeature), rxyz_feature);
          
          if(rxyz_band){
              var partial_area = turf.area(rxyz_band.geometry)/1000000;
              var avg_rxyz_obj = {id: rxyz_feature.properties.ID, coef_c: rxyz_feature.properties.C, partial_area: partial_area};
              rxyz_band.properties = _.merge(avg_rxyz_obj, basinFeature.properties);
              
              rxyz_avg_weighted_areas.push({value: avg_rxyz_obj.coef_c, weight: partial_area});
              rxyz_bands.push(rxyz_band);                      
          }
        })
      }
    });

    return {
      rau: {
        bands:  rau_bands,
        a:      calcAvgWeight(rau_avg_a_weighted_areas),
        b:      calcAvgWeight(rau_avg_b_weighted_areas),
        coef_a: calcAvgWeight(rau_avg_coef_a_weighted_areas),
        coef_b: calcAvgWeight(rau_avg_coef_b_weighted_areas),
        xt10:   calcAvgWeight(rau_avg_xt10_weigted_areas),
        qp95:   calcAvgWeight(rau_avg_qp95_weighted_areas)
      },
      rxyz: {
        bands: rxyz_bands,
        coef_c: calcAvgWeight(rxyz_avg_weighted_areas)
      }
    };
  }

  /**
   * Method to Get Mean of Annual Precipitation values of Isolines calculated,
   * Executing grid points of 1 kilometer, filtering point of basin border
   * Populating options values with Isoband calculated value
   * 
   */
  function getAvgAnnualRainByRegion(basin_border_geo){
    var isobands_bounds = basin_border_geo.getBounds();

    var extent = [isobands_bounds._southWest.lng, isobands_bounds._southWest.lat, isobands_bounds._northEast.lng, isobands_bounds._northEast.lat,];
    var cellSide = 1;
    var options = {units: 'kilometers'};
    var avg_rain_areas;
    var avg_rain_points;

    var point_grids = turf.pointGrid(extent, cellSide, options);

    var rain_avg_weighted_areas = [];
    var rain_avg_weighted_points = [];

    turf.featureEach(rain_isoline, function(rainFeature, rainIndex){
      var pts = turf.pointsWithinPolygon(point_grids, rainFeature);

      if(pts.features.length > 0){
      
        turf.featureEach(basin_border_geo.toGeoJSON(), function(basinFeature, basinIndex){
        
          //console.log("Isoband: ", rainFeature);
          //console.log("BasinShape: ", basinFeature);

          //Check basin is Polygon to convert to LineString
          if(turf.getType(basinFeature) == "Polygon"){
            //console.log("Convert Geometry: ", basinFeature);
            basinFeature = turf.polygonToLine(basinFeature);
          }

          var isoband = turf.intersect(turf.lineToPolygon(basinFeature), rainFeature);
          //console.log("Isoband AVG: ", isoband);
          if(isoband){
            var partial_area = turf.area(isoband.geometry)/1000000;
            avg_rain_obj = {rain: rainFeature.properties.ID, partial_area: partial_area};

            isoband.properties = $.extend({}, avg_rain_obj, basinFeature.properties);

            var isoband_geo = L.geoJSON(isoband, {
              onEachFeature: function(feature, layer){
                layer.on({
                  /*mouseover: highlightFeature,
                  mouseout: resetHighlight,*/
                  click: function(e){                    
                    console.log("Partial Rain: ", e.target.feature.properties);
                  }
                });
              },
              style: styleRainIsoline
            });

            rain_avg_weighted_areas.push({value: avg_rain_obj.rain, weight: partial_area});
            isolineGroup.addLayer(isoband_geo);
          }          
        });http://ankartech.com/?4-wire-basic-video-door-phone/27.html
        
        var pts_tags = turf.tag(pts, rainFeature,'ID','rain');
        var avg_rain = _.meanBy(pts_tags.features, function(o){ return o.properties.rain });
        rain_avg_weighted_points.push({value: avg_rain, weight: pts_tags.features.length});
      }
    });

    avg_rain_areas = calcAvgWeight(rain_avg_weighted_areas);
    avg_rain_points = calcAvgWeight(rain_avg_weighted_points);

    console.log("Rain Area: ",avg_rain_areas," - Points: ",avg_rain_points);
    return avg_rain_areas;
  }

  /**
   * Calculate Average using weights, using object value with weight and value parameters
   * */
  function calcAvgWeight(values){
    var total_weight = _.sumBy(values, function(o){ return o.weight });
    var aux_vals = [];

    $.each(values, function(k,v){
      aux_vals.push(v.value * v.weight);
    });

    return _.sum(aux_vals)/total_weight;
  }

  /**
   * Function to Calculate Coordinates Joins
   * */
  function calculate_coords_join(latitude=null, longitude=null){
    var latitude  = (latitude == null) ? $("#latitude").val() : latitude;
    var longitude = (longitude == null) ? $("#longitude").val() : longitude;

    console.log("Latitude: ", latitude," <> Longitude: ", longitude);

    $.get("/api/coords_join/"+latitude+"/"+longitude, function(response){
      
      //Clear all layer groups
      basinGroup.clearLayers();
      isolineGroup.clearLayers();

      //map.setView([latitude, longitude], 12)
      basin = L.geoJSON(response.ottobacia);
      basinGroup.addLayer(basin);
      
      response.isolines.bands.forEach(band => {
        isolineGroup.addLayer(L.geoJSON(band,{
            onEachFeature: function(feature, layer){
              layer.on({
                //mouseover: highlightFeature,
                //mouseout: resetHighlight,
                click: function(e){
                  
                  console.log("Partial Rain: ", e.target.feature.properties);
                }
              });
            },
            style: styleRainIsoline
          }))
      });

      map.fitBounds(basin.getBounds());

      modal_calc_q710.hide();
    })
  }

  /**
   *Method to Get Rainfall Color to Fill Isolines
   * */
  function getRainColor(feature){
    var d = (feature.properties.ID || feature.properties.rain);

    return  d > 3250  ? '#4424FD' :
            d > 2750  ? '#9D67FE' :
            d > 2250  ? '#E0A9FE' :
            d > 1750  ? '#4CCFFD' :
            d > 1450  ? '#6CE4A9' :
            d > 1350  ? '#44FE02' :
            d > 1250  ? '#F3FD47' :
            d > 1150  ? '#F9E845' :
                        '#FAAD45';
  }

  /**
   * Set Style function to Isoline
   * */
  function styleRainIsoline(feature){
    return {
          fillColor: getRainColor(feature),
          weight: 1.3,
          opacity: 1,
          color: 'gray',
          dashArray: '3',
          fillOpacity: 0.3
      };
  }


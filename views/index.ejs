          <span>Duração crítica d<sub>c</sub> — Eq. (15)</span>
          <strong>${number(scenario.critical_duration_months, 1)} meses</strong>
          <small>Valor exato: ${number(scenario.critical_duration_months, 2)} meses (limite ≤ 6,0 m)</small>
        </article>
        <article class="reg-kpi-card">
          <span>Demanda firme Q<sub>F</sub> e Risco y%</span>
          <strong>${number(scenario.qf_m3s, 2)} m³/s · ${number(scenario.failure_probability_percent, 2)}%</strong>
          <small>T = ${number(scenario.return_period_years, scenario.return_period_years % 1 ? 1 : 0)} anos · ${number(scenario.qf_percent_of_avg, 1)}% de Q̄ (${number(scenario.avg_discharge_m3s, 2)} m³/s)</small>
        </article>
        <article class="reg-kpi-card ${statusClass}">
          <span>Diagnóstico metodológico DAEE</span>
          <strong>${scenario.status === 'valid_intra_annual' ? 'Intra-anual (≤ 6 meses)' : scenario.status === 'run_of_river' ? 'Fio d’água (Vc = 0)' : 'Atenção: d_c > 6 meses'}</strong>
          <small>${scenario.status_label}</small>
        </article>
      `;

      byId('reg-formula-memory').innerHTML = `
        <div class="reg-memory-title">Memória de cálculo — ${scenario.name} (${scenario.region_label})</div>
        <div class="reg-memory-lines">
          <div><b>Equação (12) [Q<sub>1,${number(scenario.return_period_years, 0)}</sub>]:</b> <code>X<sub>T</sub> · (A + B · 1) · Q̄ = ${number(scenario.xt, 3)} · (${number(scenario.coef_a, 4)} + ${number(scenario.coef_b, 4)} · 1) · ${number(scenario.avg_discharge_m3s, 2)} = <b>${number(scenario.q1_t_m3s, 2)} m³/s</b></code></div>
          <div><b>Equação (14) [V<sub>c</sub>]:</b> <code>[ [ ${number(scenario.qf_m3s, 2)} − (${number(scenario.xt, 3)} · ${number(scenario.coef_a, 4)} · ${number(scenario.avg_discharge_m3s, 2)}) ]² / (4 · ${number(scenario.xt, 3)} · ${number(scenario.coef_b, 4)} · ${number(scenario.avg_discharge_m3s, 2)}) ] · 2.628.000 = <b>${number(scenario.volume_m3, 0)} m³ (${number(scenario.volume_hm3, 2)} × 10⁶ m³)</b></code></div>
          <div><b>Equação (15) [d<sub>c</sub>]:</b> <code>[ ${number(scenario.qf_m3s, 2)} − (${number(scenario.xt, 3)} · ${number(scenario.coef_a, 4)} · ${number(scenario.avg_discharge_m3s, 2)}) ] / (2 · ${number(scenario.xt, 3)} · ${number(scenario.coef_b, 4)} · ${number(scenario.avg_discharge_m3s, 2)}) = <b>${number(scenario.critical_duration_months, 1)} meses</b> (${number(scenario.critical_duration_months, 2)} meses)</code></div>
        </div>
      `;

      renderFigure4Chart(scenario);

      const monthlyBody = byId('reg-monthly-table-body');
      monthlyBody.replaceChildren();
      (scenario.monthly_series || []).slice(0, 6).forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <th scope="row">${item.d_months} ${item.d_months === 1 ? 'mês' : 'meses'}</th>
          <td>${number(item.q_min_m3s, 2)} m³/s</td>
          <td>${number(item.demand_volume_hm3, 2)} hm³</td>
          <td>${number(item.available_volume_hm3, 2)} hm³</td>
          <td><strong>${number(item.regularization_volume_hm3, 2)} hm³</strong></td>
          <td>${number(item.regularization_volume_m3, 0)} m³</td>
        `;
        monthlyBody.appendChild(tr);
      });
    }

    function renderRegularizationComparison(scenarios) {
      regSimulatedScenarios = scenarios;
      regResultsSection.hidden = false;
      text('reg-comparison-count', `${scenarios.length} ${scenarios.length === 1 ? 'cenário' : 'cenários'}`);

      const highestVol = [...scenarios].sort((a, b) => b.volume_hm3 - a.volume_hm3)[0];
      const first = scenarios[0];
      text('reg-comparison-summary', scenarios.length === 1
        ? `Para regularizar QF = ${number(first.qf_m3s, 2)} m³/s com ${number(first.failure_probability_percent, 2)}% (T = ${number(first.return_period_years, 0)} anos) de probabilidade de não atendimento na ${first.region_label}, o volume necessário pela Equação (14) é Vc = ${number(first.volume_hm3, 2)} hm³ (${number(first.volume_m3, 0)} m³) e a duração crítica pela Equação (15) é dc = ${number(first.critical_duration_months, 1)} meses.`
        : `Foram comparados ${scenarios.length} cenários. O maior volume de regularização ocorre em "${highestVol.name}" com Vc = ${number(highestVol.volume_hm3, 2)} hm³ (${number(highestVol.volume_m3, 0)} m³) e duração crítica dc = ${number(highestVol.critical_duration_months, 1)} meses.`
      );

      regFocusSelect.replaceChildren();
      scenarios.forEach((scen, idx) => {
        const opt = document.createElement('option');
        opt.value = String(idx);
        opt.textContent = `${scen.name} — Vc = ${number(scen.volume_hm3, 2)} hm³ · dc = ${number(scen.critical_duration_months, 1)} m`;
        regFocusSelect.appendChild(opt);
      });

      const chart = byId('reg-comparison-chart');
      chart.replaceChildren();
      const chartMetrics = [
        { key: 'volume_hm3', label: 'Volume de regularização Vc — Equação (14)', unit: 'hm³', digits: 2 },
        { key: 'critical_duration_months', label: 'Duração crítica dc — Equação (15)', unit: 'meses', digits: 1 }
      ];
      chartMetrics.forEach(metric => {
        const group = document.createElement('section');
        group.className = 'chart-group';
        const h4 = document.createElement('h4');
        h4.textContent = metric.label;
        group.appendChild(h4);
        const max = Math.max(...scenarios.map(s => Number(s[metric.key]) || 0), 0.01);
        scenarios.forEach((scen, idx) => {
          const row = document.createElement('div');
          row.className = 'chart-row';
          const label = document.createElement('span');
          label.className = 'chart-label';
          label.textContent = scen.name;
          const track = document.createElement('span');
          track.className = 'chart-track';
          const bar = document.createElement('i');
          const val = Number(scen[metric.key]) || 0;
          bar.style.width = `${val > 0 ? Math.max(3, (val / max) * 100) : 0}%`;
          bar.style.backgroundColor = scenarioColors[idx % scenarioColors.length];
          track.appendChild(bar);
          const strong = document.createElement('strong');
          strong.textContent = `${number(val, metric.digits)} ${metric.unit}`;
          const small = document.createElement('small');
          small.textContent = `${number(scen.failure_probability_percent, 1)}% (T=${number(scen.return_period_years, 0)}a)`;
          row.append(label, track, strong, small);
          group.appendChild(row);
        });
        chart.appendChild(group);
      });

      const tbody = byId('reg-comparison-table-body');
      tbody.replaceChildren();
      scenarios.forEach((scen, idx) => {
        const tr = document.createElement('tr');
        const statusShort = scen.status === 'valid_intra_annual' ? 'Intra-anual (≤ 6m)' : scen.status === 'run_of_river' ? 'Fio d’água' : 'dc > 6 meses';
        tr.innerHTML = `
          <th scope="row"><i class="scenario-swatch" style="background:${scenarioColors[idx % scenarioColors.length]}"></i><span>${scen.name}</span></th>
          <td>${scen.region_label}</td>
          <td>${number(scen.avg_discharge_m3s, 2)}</td>
          <td><strong>${number(scen.qf_m3s, 2)}</strong></td>
          <td>${number(scen.failure_probability_percent, 2)}% (T=${number(scen.return_period_years, scen.return_period_years % 1 ? 1 : 0)}a)</td>
          <td>${number(scen.xt, 3)}</td>
          <td>${number(scen.q1_t_m3s, 2)}</td>
          <td><strong>${number(scen.critical_duration_months, 1)}</strong></td>
          <td><strong>${number(scen.volume_hm3, 2)}</strong></td>
          <td>${number(scen.volume_m3, 0)}</td>
          <td>${statusShort}</td>
        `;
        tbody.appendChild(tr);
      });

      renderFocusedRegScenario(0);
    }

    async function runRegularizationSimulation() {
      if (!regQueuedScenarios.length) {
        addRegScenarioFromInputs();
        if (!regQueuedScenarios.length) return;
      }
      const base = getActiveRegBaseParams();
      if (!Number.isFinite(base.avg_discharge_m3s) || base.avg_discharge_m3s <= 0) {
        return toast('Informe uma vazão média plurianual Q̄ válida maior que zero.', 'error');
      }
      runRegSimulationButton.disabled = true;
      runRegSimulationButton.classList.add('loading');
      regSimulationStatus.textContent = 'Calculando volume de regularização (Equação 14) e duração crítica (Equação 15)…';
      try {
        const response = await fetch(`${apiBase}/api/regularization_simulation`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ base, scenarios: regQueuedScenarios })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Não foi possível executar a simulação de regularização.');
        renderRegularizationComparison(data.scenarios);
        regSimulationStatus.textContent = 'Simulação concluída com sucesso.';
      } catch (error) {
        regSimulationStatus.textContent = '';
        toast(error.message, 'error');
      } finally {
        runRegSimulationButton.disabled = false;
        runRegSimulationButton.classList.remove('loading');
      }
    }

    function applyMapBasinToRegularization() {
      if (!lastCalculation || !lastCalculation.rau) return;
      syncMapBasinOptions(lastCalculation);
      regSourceMode.value = 'map';
      regQMode.value = 'calculated';
      regAvgQInput.value = Number(lastCalculation.avg_discharge).toFixed(2);
      if (Number.isFinite(lastCalculation.area_km2)) regAreaInput.value = Number(lastCalculation.area_km2).toFixed(2);
      if (Number.isFinite(lastCalculation.isolines?.avg_areas)) regRainInput.value = Number(lastCalculation.isolines.avg_areas).toFixed(1);
      const defaultQf = Math.max(0.01, Number((lastCalculation.avg_discharge * 0.5).toFixed(2)));
      regQfInput.value = defaultQf.toFixed(2);
      updateRegBaseSummary();
      regQueuedScenarios = [
        { id: 'map-t10', name: `QF ${number(defaultQf, 2)} m³/s · 10% (T=10 anos)`, qf_m3s: defaultQf, return_period_years: 10, failure_probability_percent: 10 },
        { id: 'map-t25', name: `QF ${number(defaultQf, 2)} m³/s · 4% (T=25 anos)`, qf_m3s: defaultQf, return_period_years: 25, failure_probability_percent: 4 }
      ];
      renderRegQueuedScenarios();
    }

    function loadDaeeBuquiraExample() {
      regSourceMode.value = 'region';
      regRegionSelect.value = 'H';
      regQMode.value = 'direct';
      regAreaInput.value = '401.5';
      regRainInput.value = '1685';
      regAvgQInput.value = '9.48';
      regQfInput.value = '5.00';
      regReturnPeriodSelect.value = '10';
      regCustomProbField.hidden = true;
      updateRegBaseSummary();
      regQueuedScenarios = [
        { id: 'daee-ex-10', name: 'Exemplo DAEE (Rio Buquira) — QF 5,00 m³/s · 10% (T=10 anos)', qf_m3s: 5.0, return_period_years: 10, failure_probability_percent: 10 },
        { id: 'daee-ex-20', name: 'Rio Buquira — QF 5,00 m³/s · 5% (T=20 anos)', qf_m3s: 5.0, return_period_years: 20, failure_probability_percent: 5 },
        { id: 'daee-ex-50', name: 'Rio Buquira — QF 5,00 m³/s · 2% (T=50 anos)', qf_m3s: 5.0, return_period_years: 50, failure_probability_percent: 2 }
      ];
      renderRegQueuedScenarios();
      runRegularizationSimulation();
    }

    async function openRegularization(preferMapBasin = false) {
      try {
        await ensureRegCatalog();
        if (lastCalculation && lastCalculation.rau) {
          syncMapBasinOptions(lastCalculation);
        }
        if (preferMapBasin && lastCalculation && lastCalculation.rau) {
          applyMapBasinToRegularization();
        } else if (!regQueuedScenarios.length) {
          if (lastCalculation && lastCalculation.rau) applyMapBasinToRegularization();
          else loadDaeeBuquiraExample();
        } else {
          updateRegBaseSummary();
        }
        regDialog.showModal();
        runRegularizationSimulation();
      } catch (error) {
        toast(error.message, 'error');
      }
    }

    byId('open-regularization').onclick = () => openRegularization(true);
    byId('open-regularization-header').onclick = () => openRegularization(false);
    byId('close-regularization').onclick = () => regDialog.close();
    regDialog.addEventListener('click', event => { if (event.target === regDialog) regDialog.close(); });
    async function ensureMapCalculationIfAvailable() {
      if (lastCalculation && Number.isFinite(lastCalculation.avg_discharge)) return true;
      const lat = Number(String(latInput.value).replace(',', '.'));
      const lon = Number(String(lonInput.value).replace(',', '.'));
      if (String(latInput.value).trim() !== '' && String(lonInput.value).trim() !== '' && Number.isFinite(lat) && Number.isFinite(lon)) {
        await calculate(lat, lon);
        return Boolean(lastCalculation && Number.isFinite(lastCalculation.avg_discharge));
      }
      return false;
    }

    regSourceMode.onchange = async () => {
      if (regSourceMode.value === 'map') {
        const hasCalc = await ensureMapCalculationIfAvailable();
        if (hasCalc) {
          applyMapBasinToRegularization();
          runRegularizationSimulation();
          return;
        }
        toast('Selecione um ponto no mapa e clique em Calcular vazão para obter os dados da bacia.', 'error');
        regSourceMode.value = 'region';
      } else if (regSourceMode.value === 'region' && regQMode.value === 'calculated' && (!lastCalculation || !Number.isFinite(lastCalculation.avg_discharge))) {
        regQMode.value = 'direct';
      }
      updateRegBaseSummary();
    };
    regRegionSelect.onchange = updateRegBaseSummary;
    regQMode.onchange = async () => {
      if (regQMode.value === 'calculated') {
        const hasCalc = await ensureMapCalculationIfAvailable();
        if (!hasCalc) {
          toast('Calcule uma bacia no mapa primeiro para usar a vazão calculada.', 'error');
          regQMode.value = 'direct';
        }
      }
      updateRegBaseSummary();
    };
    regAvgQInput.oninput = updateRegBaseSummary;
    regAreaInput.oninput = updateRegBaseSummary;
    regRainInput.oninput = updateRegBaseSummary;
    regReturnPeriodSelect.onchange = () => { regCustomProbField.hidden = regReturnPeriodSelect.value !== 'custom'; };
    byId('reg-add-scenario').onclick = addRegScenarioFromInputs;
    byId('reg-add-all-risks').onclick = addAllRiskScenariosForCurrentQf;
    byId('reg-clear-scenarios').onclick = () => { regQueuedScenarios = []; renderRegQueuedScenarios(); regResultsSection.hidden = true; };
    byId('reg-load-daee-example').onclick = loadDaeeBuquiraExample;
    byId('reg-use-map-basin').onclick = () => { applyMapBasinToRegularization(); runRegularizationSimulation(); };
    runRegSimulationButton.onclick = runRegularizationSimulation;
    regFocusSelect.onchange = () => renderFocusedRegScenario(Number(regFocusSelect.value));
    document.querySelectorAll('.reg-chip').forEach(chip => {
      chip.onclick = () => {
        const base = getActiveRegBaseParams();
        const ratio = Number(chip.dataset.qfRatio);
        if (Number.isFinite(base.avg_discharge_m3s) && base.avg_discharge_m3s > 0 && Number.isFinite(ratio)) {
          regQfInput.value = Math.max(0.01, base.avg_discharge_m3s * ratio).toFixed(2);
        }
      };
    });
    document.addEventListener('keydown', event => {
      if ((!isDrawing && !drawingAdjustmentRegion) || isEditableTarget(event.target)) return;
      if (!event.repeat && (event.key.toLowerCase() === 'd' || event.key === 'Backspace')) { if (undoLastDrawnVertex()) event.preventDefault(); }
      if (event.key === 'Escape') {
        event.preventDefault();
        if (drawingAdjustmentRegion) { drawingAdjustmentRegion = false; map.pm.disableDraw('Polygon'); map.pm.removeControls(); text('isohyet-editor-status', 'Desenho da região cancelado.'); }
        else { setDrawingMode(false); toast('Desenho cancelado.'); }
      }
    });
    const hash = location.hash.slice(1).split('/'); if (hash.length === 3 && hash.every(v => v.trim() !== '' && Number.isFinite(Number(v)))) { const lat = Number(hash[1]), lon = Number(hash[2]); map.setView([lat,lon], Number(hash[0])); selectPoint(lat,lon); }
  })();
  </script>
</body>
</html>

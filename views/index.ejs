      clearSimulationLayers();
      scenarios.forEach((scenario, index) => {
        const layer = L.geoJSON(scenario.bands, { style: { color: scenarioColors[index], weight: 2.2, opacity: .9, fillOpacity: .05, dashArray: index ? '7 5' : null } }).addTo(map);
        layerControl.addOverlay(layer, `Isoietas — ${scenario.name}`);
        simulationMapLayers.push({ layer, name: scenario.name });
      });
      byId('comparison-results').hidden = false;
    }
    async function runIsohyetSimulation() {
      const checked = [...scenarioList.querySelectorAll('input:checked')].map(input => input.dataset.scenarioId);
      if (!checked.length) return toast('Selecione ao menos uma camada de isoietas.', 'error');
      const scenarios = checked.map(id => {
        const catalogItem = catalogIsohyets.find(item => item.id === id);
        if (catalogItem) return { id, name: catalogItem.name };
        if (id === 'historical-1980') return { id, name: 'Isoietas históricas (pré-1980)' };
        const item = uploadedIsohyets.find(layer => layer.id === id);
        return { id: item.id, name: item.name, layer: item.layer };
      });
      runSimulationButton.disabled = true; runSimulationButton.classList.add('loading'); simulationStatus.textContent = 'Cruzando as isoietas com a bacia…';
      try {
        const json = JSON.stringify({ geometry: lastCalculation.ottobacia, scenarios });
        let body = json;
        const headers = { 'Content-Type': 'application/json' };
        if ('CompressionStream' in window) {
          const stream = new Blob([json]).stream().pipeThrough(new CompressionStream('gzip'));
          body = await new Response(stream).blob();
          headers['Content-Encoding'] = 'gzip';
        }
        const response = await fetch('/api/isohyet_simulation', { method: 'POST', headers, body });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || (response.status === 413 ? 'O servidor ou proxy recusou o tamanho da requisição.' : 'Não foi possível executar a simulação.'));
        renderComparison(data.scenarios); simulationStatus.textContent = 'Simulação concluída.'; byId('comparison-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) { simulationStatus.textContent = ''; toast(error.message, 'error'); }
      finally { runSimulationButton.disabled = false; runSimulationButton.classList.remove('loading'); }
    }
    async function openSimulation() {
      if (!lastCalculation) return toast('Calcule uma bacia antes de iniciar a simulação.', 'error');
      if (!catalogIsohyets.length) {
        try { const response = await fetch('/api/isohyet_catalog'); if (response.ok) catalogIsohyets = await response.json(); }
        catch (_) { /* A camada histórica de fallback continua disponível. */ }
      }
      renderScenarioList(); simulationDialog.showModal();
    }
    function setSearchOpen(value) { searchPanel.classList.toggle('open', value); document.body.classList.toggle('search-open', value); byId('open-search').setAttribute('aria-expanded', String(value)); }
    function startNewConsultation() {
      controller?.abort(); controller = null;
      if (simulationDialog.open) simulationDialog.close();
      if (isIsohyetEditing) closeIsohyetEditor(false);
      if (isDrawing) setDrawingMode(false);
      clearSimulationLayers();
      if (marker) { map.removeLayer(marker); marker = null; }
      fullBasinLayer.clearLayers(); basinLayer.clearLayers(); crossSectionLayer.clearLayers(); basinOverlapLayer.clearLayers(); rainLayer.clearLayers(); streamLayer.clearLayers(); streamEndpointLayer.clearLayers();
      form.reset(); lastCalculation = null; simulationButton.disabled = true;
      loading.hidden = true; content.hidden = true; empty.hidden = false;
      empty.querySelector('h3').textContent = 'Selecione um ponto';
      empty.querySelector('p').textContent = 'Preencha as coordenadas ou clique no mapa para calcular as vazões da bacia correspondente.';
      byId('comparison-results').hidden = true; byId('toast').hidden = true;
      text('map-hint', 'Clique no mapa para escolher um ponto'); byId('map-hint').classList.remove('selected');
      closeResults(); setSearchOpen(true);
      history.replaceState(null, '', `${location.pathname}${location.search}`);
      setTimeout(() => latInput.focus(), 260);
    }
    form.addEventListener('submit', e => { e.preventDefault(); const lat = Number(String(latInput.value).replace(',','.')), lon = Number(String(lonInput.value).replace(',','.')); if (!Number.isFinite(lat) || lat < -90 || lat > 90 || !Number.isFinite(lon) || lon < -180 || lon > 180) { toast('Informe latitude e longitude válidas em graus decimais.', 'error'); (!Number.isFinite(lat) ? latInput : lonInput).focus(); return; } selectPoint(lat, lon); if (innerWidth < 720) setSearchOpen(false); calculate(lat, lon); });
    includeUpstreamInput.addEventListener('change', () => {
      const lat = Number(String(latInput.value).replace(',', '.'));
      const lon = Number(String(lonInput.value).replace(',', '.'));
      if (Number.isFinite(lat) && lat >= -90 && lat <= 90 && Number.isFinite(lon) && lon >= -180 && lon <= 180 && String(latInput.value).trim() !== '' && String(lonInput.value).trim() !== '') {
        calculate(lat, lon);
      } else if (lastCalculation && lastCalculation.source !== 'drawn-geometry' && Number.isFinite(lastCalculation.latitude) && Number.isFinite(lastCalculation.longitude)) {
        calculate(lastCalculation.latitude, lastCalculation.longitude);
      }
    });
    map.on('click', e => { if (isDrawing || isIsohyetEditing) return; selectPoint(e.latlng.lat, e.latlng.lng); if (innerWidth < 720) setSearchOpen(true); });
    map.on('pm:create', event => {
      if (event.shape !== 'Polygon') return;
      if (drawingAdjustmentRegion) { applyRegionalVariation(event.layer.toGeoJSON(), event.layer); return; }
      calculateDrawnGeometry(event.layer.toGeoJSON(), event.layer);
    });
    locateButton.addEventListener('click', () => { if (!navigator.geolocation) return toast('Geolocalização indisponível neste navegador.', 'error'); locateButton.disabled = true; navigator.geolocation.getCurrentPosition(p => { locateButton.disabled = false; selectPoint(p.coords.latitude, p.coords.longitude, true); toast('Localização preenchida. Confira o ponto e calcule a vazão.'); }, e => { locateButton.disabled = false; toast(e.code === 1 ? 'Permita o acesso à localização para usar este recurso.' : 'Não foi possível obter sua localização.', 'error'); }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }); });
    byId('open-search').onclick = startNewConsultation; byId('close-search').onclick = () => setSearchOpen(false); byId('close-results').onclick = closeResults; byId('close-toast').onclick = () => byId('toast').hidden = true;
    simulationButton.onclick = openSimulation; byId('close-simulation').onclick = () => simulationDialog.close(); uploadInput.onchange = () => addIsohyetFiles(uploadInput.files); runSimulationButton.onclick = runIsohyetSimulation;
    simulationDialog.addEventListener('click', event => { if (event.target === simulationDialog) simulationDialog.close(); });
    byId('apply-isohyet-value').onclick = applySelectedIsohyetValue;
    byId('toggle-isohyet-shape').onclick = () => {
      if (!selectedIsohyetLayer) return;
      if (selectedIsohyetLayer.pm.enabled()) { selectedIsohyetLayer.pm.disable(); byId('toggle-isohyet-shape').textContent = 'Editar forma'; text('isohyet-editor-status', 'Edição de vértices concluída.'); }
      else { selectedIsohyetLayer.pm.enable({ allowSelfIntersection: false, snappable: true }); byId('toggle-isohyet-shape').textContent = 'Concluir forma'; text('isohyet-editor-status', 'Arraste os vértices da faixa no mapa.'); }
    };
    byId('draw-adjustment-region').onclick = () => {
      const percentage = Number(percentageInput.value); if (!Number.isFinite(percentage) || percentage <= -100 || percentage > 500) return toast('Informe uma variação entre -99% e 500%.', 'error');
      if (selectedIsohyetLayer) selectedIsohyetLayer.pm.disable(); drawingAdjustmentRegion = true; text('isohyet-editor-status', 'Desenhe e finalize a região que receberá a variação.');
      map.pm.addControls({ position: 'topright', drawMarker:false, drawCircleMarker:false, drawPolyline:false, drawRectangle:false, drawCircle:false, drawText:false, editMode:false, dragMode:false, cutPolygon:false, removalMode:false, rotateMode:false });
      map.pm.enableDraw('Polygon', { snappable: true, allowSelfIntersection: false, pathOptions: { color: '#d97706', weight: 3, fillOpacity: .12 } });
    };
    byId('cancel-isohyet-edit').onclick = () => closeIsohyetEditor(true); byId('save-isohyet-edit').onclick = saveIsohyetEdit;
    startDrawingButton.onclick = () => setDrawingMode(true); cancelDrawingButton.onclick = () => { setDrawingMode(false); toast('Desenho cancelado.'); };
    document.addEventListener('keydown', event => {
      if ((!isDrawing && !drawingAdjustmentRegion) || isEditableTarget(event.target)) return;
      if (!event.repeat && (event.key.toLowerCase() === 'd' || event.key === 'Backspace')) { if (undoLastDrawnVertex()) event.preventDefault(); }
      if (event.key === 'Escape') {
        event.preventDefault();
        if (drawingAdjustmentRegion) { drawingAdjustmentRegion = false; map.pm.disableDraw('Polygon'); map.pm.removeControls(); text('isohyet-editor-status', 'Desenho da região cancelado.'); }
        else { setDrawingMode(false); toast('Desenho cancelado.'); }
      }
    });
    const hash = location.hash.slice(1).split('/'); if (hash.length === 3 && hash.every(v => v.trim() !== '' && Number.isFinite(Number(v)))) { const lat = Number(hash[1]), lon = Number(hash[2]); map.setView([lat,lon], Number(hash[0])); selectPoint(lat,lon); }
  })();
  </script>
</body>
</html>

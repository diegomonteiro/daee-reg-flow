    async function ensureRegCatalog() {
      if (regCatalog) return regCatalog;
      const response = await fetch(`${apiBase}/api/regularization_catalog`);
      if (!response.ok) throw new Error('Não foi possível carregar a tabela de parâmetros regionais.');
      regCatalog = await response.json();
      regRegionSelect.replaceChildren();
      (regCatalog.regions || []).forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.region;
        opt.textContent = `Região ${item.region} (A = ${number(item.coef_a, 4)}; B = ${number(item.coef_b, 4)}; X₁₀ = ${number(item.xt_by_period?.[10], 3)})`;
        if (item.region === 'H') opt.selected = true;
        regRegionSelect.appendChild(opt);
      });
      return regCatalog;
    }

    const regQCalculatedOption = byId('reg-q-calculated-option');

    function syncMapBasinOptions(data) {
      if (!data || !data.rau || !Number.isFinite(data.avg_discharge)) return;
      regSourceMapOption.disabled = false;
      regSourceMapOption.textContent = `Bacia selecionada no mapa (Q̄ = ${number(data.avg_discharge, 2)} m³/s)`;
      if (regQCalculatedOption) {
        regQCalculatedOption.disabled = false;
        regQCalculatedOption.textContent = `Usar vazão calculada da bacia (Q̄ = ${number(data.avg_discharge, 2)} m³/s)`;
      }
      byId('reg-use-map-basin').hidden = false;
    }

    function getActiveRegBaseParams() {
      const useMap = regSourceMode.value === 'map' && lastCalculation && lastCalculation.rau;
      const useCalculatedQ = regQMode.value === 'calculated' && lastCalculation && Number.isFinite(lastCalculation.avg_discharge);
      if (useMap) {
        const rau = lastCalculation.rau;
        const regions = [...new Set((rau.bands || []).map(i => i.properties?.region).filter(Boolean))].map(r => r.toUpperCase());
        const regionLabel = regions.length ? regions.join(', ') : 'Bacia';
        const singleRegion = regions.length === 1 ? regions[0] : null;
        const avgA = Number(rau.avg_a), avgB = Number(rau.avg_b), coefA = Number(rau.coef_a), coefB = Number(rau.coef_b);
        const areaKm2 = Number(lastCalculation.area_km2), rainfallMm = Number(lastCalculation.isolines?.avg_areas);
        const avgQ = useCalculatedQ
          ? Number(lastCalculation.avg_discharge)
          : regQMode.value === 'rainfall' && Number.isFinite(Number(regAreaInput.value)) && Number.isFinite(Number(regRainInput.value))
            ? ((avgA + avgB * Number(regRainInput.value)) * Number(regAreaInput.value)) / 1000
            : Number(regAvgQInput.value || lastCalculation.avg_discharge);
        return {
          source: 'map',
          region: singleRegion,
          region_label: `Bacia (${regionLabel})`,
          avg_a: avgA,
          avg_b: avgB,
          coef_a: coefA,
          coef_b: coefB,
          xt_by_period: rau.xt_by_period || null,
          area_km2: regQMode.value === 'rainfall' ? Number(regAreaInput.value) : areaKm2,
          avg_rainfall_mm: regQMode.value === 'rainfall' ? Number(regRainInput.value) : rainfallMm,
          avg_discharge_m3s: avgQ
        };
      }
      const selectedRegionCode = regRegionSelect.value || 'H';
      const regionEntry = (regCatalog?.regions || []).find(r => r.region === selectedRegionCode) || {
        region: 'H', avg_a: -29.47, avg_b: 0.0315, coef_a: 0.4951, coef_b: 0.0279,
        xt_by_period: { 10: 0.748, 15: 0.723, 20: 0.708, 25: 0.698, 50: 0.673, 100: 0.656 }
      };
      const areaKm2 = Number(regAreaInput.value);
      const rainfallMm = Number(regRainInput.value);
      const avgQ = useCalculatedQ
        ? Number(lastCalculation.avg_discharge)
        : regQMode.value === 'rainfall'
          ? ((regionEntry.avg_a + regionEntry.avg_b * rainfallMm) * areaKm2) / 1000
          : Number(regAvgQInput.value);
      return {
        source: 'region',
        region: regionEntry.region,
        region_label: `Região ${regionEntry.region}`,
        avg_a: regionEntry.avg_a,
        avg_b: regionEntry.avg_b,
        coef_a: regionEntry.coef_a,
        coef_b: regionEntry.coef_b,
        xt_by_period: regionEntry.xt_by_period,
        area_km2: areaKm2,
        avg_rainfall_mm: rainfallMm,
        avg_discharge_m3s: avgQ
      };
    }

    function updateRegBaseSummary() {
      regRegionField.hidden = regSourceMode.value === 'map';
      const byRainfall = regQMode.value === 'rainfall';
      const byCalculated = regQMode.value === 'calculated' && lastCalculation && Number.isFinite(lastCalculation.avg_discharge);
      regQDirectField.hidden = byRainfall;
      regAreaField.hidden = !byRainfall;
      regRainField.hidden = !byRainfall;
      regAvgQInput.readOnly = Boolean(byCalculated);
      if (byId('reg-q-direct-label')) {
        byId('reg-q-direct-label').textContent = byCalculated ? 'Vazão média calculada da bacia Q̄ (m³/s)' : 'Vazão média plurianual Q̄ (m³/s)';
      }
      const base = getActiveRegBaseParams();
      if ((byRainfall || byCalculated) && Number.isFinite(base.avg_discharge_m3s) && base.avg_discharge_m3s > 0) {
        regAvgQInput.value = base.avg_discharge_m3s.toFixed(2);
      }
      const xt10 = base.xt_by_period?.[10] ?? 0.748;
      const q0_10 = Number.isFinite(base.avg_discharge_m3s) ? xt10 * base.coef_a * base.avg_discharge_m3s : NaN;
      const q1_10 = Number.isFinite(base.avg_discharge_m3s) ? xt10 * (base.coef_a + base.coef_b) * base.avg_discharge_m3s : NaN;
      const qMaxIntra10 = Number.isFinite(base.avg_discharge_m3s) ? Math.min(base.avg_discharge_m3s, xt10 * (base.coef_a + 12 * base.coef_b) * base.avg_discharge_m3s) : NaN;
      byId('reg-params-summary').innerHTML = `
        <div><span>Origem / Região</span><strong>${base.region_label}</strong></div>
        <div><span>Coeficiente A</span><strong>${number(base.coef_a, 4)}</strong></div>
        <div><span>Coeficiente B</span><strong>${number(base.coef_b, 4)}</strong></div>
        <div><span>Fator X<sub>10</sub> (T=10a)</span><strong>${number(xt10, 3)}</strong></div>
        <div><span>Vazão média Q̄</span><strong>${number(base.avg_discharge_m3s, 2)} m³/s</strong></div>
        <div><span>Q<sub>1,10</sub> (Eq. 12)</span><strong>${number(q1_10, 2)} m³/s</strong></div>
        <div><span>Faixa intra-anual (T=10a)</span><strong>${number(q0_10, 2)} a ${number(qMaxIntra10, 2)} m³/s</strong></div>
      `;
    }

    function renderRegQueuedScenarios() {
      regScenarioList.replaceChildren();
      if (!regQueuedScenarios.length) {
        const emptyMsg = document.createElement('p');
        emptyMsg.className = 'upload-help';
        emptyMsg.textContent = 'Nenhum cenário na fila. Adicione ao menos um cenário acima.';
        regScenarioList.appendChild(emptyMsg);
        return;
      }
      regQueuedScenarios.forEach((scen, idx) => {
        const row = document.createElement('div');
        row.className = 'scenario-option reg-queued-item';
        const badge = document.createElement('span');
        badge.className = 'reg-scenario-index';
        badge.style.backgroundColor = scenarioColors[idx % scenarioColors.length];
        badge.textContent = String(idx + 1);
        const copy = document.createElement('span');
        copy.className = 'scenario-copy';
        const title = document.createElement('strong');
        const prob = 100 / scen.return_period_years;
        title.textContent = scen.name || `Cenário ${idx + 1} — QF = ${number(scen.qf_m3s, 2)} m³/s · Risco ${number(prob, 2)}% (T = ${number(scen.return_period_years, 1)} anos)`;
        const detail = document.createElement('small');
        detail.textContent = `Demanda firme QF: ${number(scen.qf_m3s, 2)} m³/s (${number(scen.qf_m3s * 1000, 0)} L/s) · Probabilidade de não atendimento: ${number(prob, 2)}% ao ano (T = ${number(scen.return_period_years, 1)} anos)`;
        copy.append(title, detail);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'scenario-remove';
        remove.textContent = 'Remover';
        remove.onclick = () => {
          regQueuedScenarios = regQueuedScenarios.filter(item => item.id !== scen.id);
          renderRegQueuedScenarios();
        };
        row.append(badge, copy, remove);
        regScenarioList.appendChild(row);
      });
    }

    function addRegScenarioFromInputs() {
      if (regQueuedScenarios.length >= 12) return toast('O limite é de 12 cenários por simulação.', 'error');
      const qf = Number(String(regQfInput.value).replace(',', '.'));
      if (!Number.isFinite(qf) || qf <= 0) return toast('Informe uma vazão firme QF maior que zero (em m³/s).', 'error');
      let tYears;
      if (regReturnPeriodSelect.value === 'custom') {
        const prob = Number(String(regCustomProbInput.value).replace(',', '.'));
        if (!Number.isFinite(prob) || prob <= 0 || prob >= 100) return toast('Informe uma probabilidade anual y% entre 0,5% e 99%.', 'error');
        tYears = 100 / prob;
      } else {
        tYears = Number(regReturnPeriodSelect.value);
      }
      const prob = 100 / tYears;
      const customName = regScenarioNameInput.value.trim();
      const name = customName || `QF ${number(qf, 2)} m³/s · ${number(prob, 2)}% (T=${number(tYears, tYears % 1 ? 1 : 0)} anos)`;
      regQueuedScenarios.push({
        id: `reg-${Date.now()}-${regQueuedScenarios.length + 1}`,
        name,
        qf_m3s: qf,
        return_period_years: tYears,
        failure_probability_percent: prob
      });
      regScenarioNameInput.value = '';
      renderRegQueuedScenarios();
    }

    function addAllRiskScenariosForCurrentQf() {
      const qf = Number(String(regQfInput.value).replace(',', '.'));
      if (!Number.isFinite(qf) || qf <= 0) return toast('Informe uma vazão firme QF maior que zero (em m³/s).', 'error');
      const periods = [10, 15, 20, 25, 50, 100];
      regQueuedScenarios = periods.map((t, i) => {
        const prob = 100 / t;
        return {
          id: `reg-risk-${t}-${Date.now()}-${i}`,
          name: `QF ${number(qf, 2)} m³/s · ${number(prob, 2)}% (T=${t} anos)`,
          qf_m3s: qf,
          return_period_years: t,
          failure_probability_percent: prob
        };
      });
      renderRegQueuedScenarios();
      runRegularizationSimulation();
    }

    function renderFigure4Chart(scenario) {
      const container = byId('reg-figure4-chart');
      if (!container || !scenario) return;
      const series = scenario.monthly_series || [];
      const maxD = 12;
      const k = scenario.k_seconds_per_month || 2628000;
      const maxDemandHm3 = (scenario.qf_m3s * k * maxD) / 1e6;
      const maxAvailHm3 = series.length ? series[series.length - 1].available_volume_hm3 : maxDemandHm3;
      const yMax = Math.max(maxDemandHm3, maxAvailHm3, scenario.volume_hm3 * 1.3, 1) * 1.08;

      const width = 760, height = 300, padL = 62, padR = 26, padT = 22, padB = 42;
      const plotW = width - padL - padR, plotH = height - padT - padB;
      const xPos = d => padL + (d / maxD) * plotW;
      const yPos = v => padT + plotH - Math.min(1, Math.max(0, v / yMax)) * plotH;

      const availPts = [`${xPos(0).toFixed(1)},${yPos(0).toFixed(1)}`];
      const demandPts = [`${xPos(0).toFixed(1)},${yPos(0).toFixed(1)}`, `${xPos(maxD).toFixed(1)},${yPos(maxDemandHm3).toFixed(1)}`];
      for (let step = 1; step <= 48; step++) {
        const d = (step / 48) * maxD;
        const qd = scenario.xt * (scenario.coef_a + scenario.coef_b * d) * scenario.avg_discharge_m3s;
        const volHm3 = (qd * k * d) / 1e6;
        availPts.push(`${xPos(d).toFixed(1)},${yPos(volHm3).toFixed(1)}`);
      }

      const dc = Math.max(0, Math.min(maxD, scenario.critical_duration_months));
      const demandAtDcHm3 = (scenario.qf_m3s * k * dc) / 1e6;
      const availAtDcHm3 = (scenario.xt * (scenario.coef_a + scenario.coef_b * dc) * scenario.avg_discharge_m3s * k * dc) / 1e6;

      let gridLines = '';
      for (let i = 0; i <= 4; i++) {
        const val = (yMax * i) / 4;
        const y = yPos(val).toFixed(1);
        gridLines += `<line x1="${padL}" y1="${y}" x2="${width - padR}" y2="${y}" stroke="#e2ecee" stroke-dasharray="3 3"/>`;
        gridLines += `<text x="${padL - 8}" y="${Number(y) + 4}" text-anchor="end" fill="#526871" font-size="10">${number(val, 1)}</text>`;
      }
      for (let d = 0; d <= 12; d += 2) {
        const x = xPos(d).toFixed(1);
        gridLines += `<line x1="${x}" y1="${padT}" x2="${x}" y2="${padT + plotH}" stroke="#eef3f5"/>`;
        gridLines += `<text x="${x}" y="${padT + plotH + 16}" text-anchor="middle" fill="#526871" font-size="10">${d} m</text>`;
      }
      const x6 = xPos(6).toFixed(1);

      container.innerHTML = `
        <svg viewBox="0 0 ${width} ${height}" width="100%" height="290" role="img" aria-label="Gráfico da Figura 4 do DAEE mostrando volume demandado, volume disponível e volume máximo de regularização Vc">
          <rect x="${padL}" y="${padT}" width="${xPos(6) - padL}" height="${plotH}" fill="#f0f8ff" opacity="0.55"/>
          ${gridLines}
          <line x1="${x6}" y1="${padT}" x2="${x6}" y2="${padT + plotH}" stroke="#d97706" stroke-width="1.5" stroke-dasharray="5 4"/>
          <text x="${Number(x6) - 6}" y="${padT + 13}" text-anchor="end" fill="#b45309" font-size="10" font-weight="700">Limite intra-anual (d = 6 meses)</text>
          <polyline fill="none" stroke="#059669" stroke-width="2.6" points="${availPts.join(' ')}"/>
          <polyline fill="none" stroke="#086fc1" stroke-width="2.6" points="${demandPts.join(' ')}"/>
          ${dc > 0 ? `
            <line x1="${xPos(dc).toFixed(1)}" y1="${yPos(demandAtDcHm3).toFixed(1)}" x2="${xPos(dc).toFixed(1)}" y2="${yPos(availAtDcHm3).toFixed(1)}" stroke="#e11d48" stroke-width="3"/>
            <circle cx="${xPos(dc).toFixed(1)}" cy="${yPos(demandAtDcHm3).toFixed(1)}" r="4.5" fill="#e11d48" stroke="#fff" stroke-width="1.5"/>
            <circle cx="${xPos(dc).toFixed(1)}" cy="${yPos(availAtDcHm3).toFixed(1)}" r="4.5" fill="#e11d48" stroke="#fff" stroke-width="1.5"/>
            <text x="${Math.min(width - padR - 110, xPos(dc) + 8).toFixed(1)}" y="${((yPos(demandAtDcHm3) + yPos(availAtDcHm3)) / 2).toFixed(1)}" fill="#be123c" font-size="11" font-weight="800">Vc = ${number(scenario.volume_hm3, 2)} hm³ (dc = ${number(scenario.critical_duration_months, 1)} m)</text>
          ` : ''}
          <line x1="${padL}" y1="${padT + plotH}" x2="${width - padR}" y2="${padT + plotH}" stroke="#9fb1b8"/>
          <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="#9fb1b8"/>
          <text x="${padL + plotW / 2}" y="${height - 6}" text-anchor="middle" fill="#17262d" font-size="11" font-weight="700">Duração d (meses)</text>
          <text x="15" y="${padT + plotH / 2}" text-anchor="middle" fill="#17262d" font-size="11" font-weight="700" transform="rotate(-90 15 ${padT + plotH / 2})">Volume acumulado (hm³)</text>
        </svg>
      `;
    }

    function renderFocusedRegScenario(index) {

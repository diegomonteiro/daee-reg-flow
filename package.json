{
  "name": "daee-reg-flow",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "check": "node scripts/check.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:python": "node scripts/hydrology-suite.js",
    "test:all": "npm run check && npm test && npm run test:python"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "compression": "^1.8.1",
    "debug": "^4.4.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "http-errors": "^2.0.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "nodemon": "^3.1.0"
  },
  "nodemonConfig": {
    "ext": "js,json,ejs,css"
  }
}

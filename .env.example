# Ambiente de execução (development | production)
NODE_ENV=production

# Subpath de publicação atrás do Nginx existente (em produção: /reg-flow)
BASE_PATH=/reg-flow

# Porta interna da aplicação Node.js e interface de bind
PORT=3001
HOST=0.0.0.0

# Porta exposta no host pelo Docker Compose (para o Nginx do servidor fazer proxy_pass)
HOST_PORT=3001

# Configuração de proxy reverso para identificação correta de IP no rate limit (1 = confia no 1º hop X-Forwarded-For)
TRUST_PROXY=1

# Limite de memória heap do Node.js para operações geoespaciais em memória
NODE_OPTIONS=--max-old-space-size=1024

# Token do Mapbox para consulta auxiliar de elevação (MAPBOX_TOKEN ou API_TOKEN)
MAPBOX_TOKEN=
API_TOKEN=

# Delimitação MDE das consultas parciais (preparação: docs/DEM_DELINEATION.md)
DEM_PYTHON=python3
DEM_D8_PATH=
DEM_ACCUMULATION_PATH=

# Área contribuinte mínima para extrair células da rede D8 (km²); não é limite de distância
DEM_MIN_DRAINAGE_AREA_KM2=0.1

# Opcional: MDE de entrada para exibição (padrão: elevation.tif ao lado do D8)
DEM_ELEVATION_PATH=
